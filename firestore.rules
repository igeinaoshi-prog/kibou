rules_version = '2';

// Firebaseコンソール > Firestore Database > ルール タブに、
// この内容をそのまま貼り付けて「公開」してください。
//
// 【重要な注意】
// このルールは「誰でも読み書きできる」設定です。ログイン機能がないため、
// URL(や公開されているFirebase設定)を知っている人は誰でもデータを
// 読み書きできてしまいます。社内の限られた人にだけURLを共有する運用を
// 前提としています。より厳密に管理したい場合は、Firebase Authentication
// (メール/パスワードなど)を追加し、request.auth != null 等の条件を
// 加えることをおすすめします。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
